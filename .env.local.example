# Supabase — copie este arquivo para .env.local e preencha com suas chaves reais.
# NUNCA commite o .env.local nem cole a service role key aqui.

NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua_anon_publishable_key_aqui

# Service Role Key — SOMENTE server-side. Pegue em Supabase > Settings > API.
# NUNCA exponha no cliente e NUNCA comite com valor real.
SUPABASE_SERVICE_ROLE_KEY=sua_service_role_key_aqui

# Storage bucket
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET=product-photos
